---
import Base from '../../layouts/Base.astro';
import CardEmpreendimento from '../../components/CardEmpreendimento.astro';
import FaixaCorretor from '../../components/FaixaCorretor.astro';
import { listarEmpreendimentos } from '../../lib/empreendimentos';

const emps = await listarEmpreendimentos();
const conta = (f: string) => emps.filter((e) => e.data.fase === f).length;
const filtros = [
  { valor: 'todos', label: 'Todos', n: emps.length },
  { valor: 'lancamento', label: 'Lançamento', n: conta('lancamento') },
  { valor: 'em-obras', label: 'Em obras', n: conta('em-obras') },
  { valor: 'entregue', label: 'Entregues', n: conta('entregue') },
];
---
<Base titulo="Empreendimentos" descricao="Conheça os empreendimentos Terrari: modernos, funcionais e de qualidade. Filtre por fase da obra e veja cada projeto em detalhe.">
  <section class="bg-tinta">
    <div class="wrap topo">
      <p class="rotulo">Portfólio</p>
      <h1>Empreendimentos Terrari</h1>
      <p class="sub">Modernos, funcionais e de qualidade. Escolha por fase da obra e conheça cada projeto em detalhe.</p>
    </div>
  </section>

  <section class="wrap lista">
    <div class="barra">
      <div role="group" aria-label="Filtrar por fase" class="filtros">
        {filtros.map((f, i) => (
          <button type="button" data-filtro={f.valor} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label} ({f.n})</button>
        ))}
      </div>
      <p class="muted fs14" aria-live="polite" data-status>Mostrando {emps.length} de {emps.length}</p>
    </div>
    <div class="grade" data-grade>
      {emps.map((e) => <CardEmpreendimento emp={e} variante="completo" />)}
    </div>
    <p class="vazio muted" data-vazio hidden>Nenhum empreendimento nesta fase no momento.</p>
  </section>

  <FaixaCorretor />
</Base>

<script>
  const botoes = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grade] .card')];
  const status = document.querySelector('[data-status]')!;
  const vazio = document.querySelector<HTMLElement>('[data-vazio]')!;
  const aplicar = (f: string) => {
    let n = 0;
    cards.forEach((c) => {
      const mostra = f === 'todos' || c.dataset.fase === f;
      c.hidden = !mostra;
      if (mostra) n++;
    });
    botoes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === f)));
    status.textContent = `Mostrando ${n} de ${cards.length}`;
    vazio.hidden = n > 0;
    const url = new URL(location.href);
    f === 'todos' ? url.searchParams.delete('fase') : url.searchParams.set('fase', f);
    history.replaceState(null, '', url);
  };
  botoes.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.filtro!)));
  const inicial = new URLSearchParams(location.search).get('fase');
  if (inicial && botoes.some((b) => b.dataset.filtro === inicial)) aplicar(inicial);
</script>

<style>
  .topo { padding-top: 72px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 20px; }
  .topo h1 { font-size: clamp(40px, 5vw, 64px); line-height: 1.04; max-width: 820px; }
  .sub { font-size: 19px; line-height: 1.55; color: var(--texto-claro); max-width: 620px; }
  .lista { padding-top: 48px; padding-bottom: 96px; }
  .barra { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 40px; border-bottom: 1px solid var(--linha-2); padding-bottom: 20px; }
  .filtros { display: flex; flex-wrap: wrap; gap: 8px; }
  .filtros button { font: 600 15px var(--corpo); min-height: 48px; padding: 13px 20px; background: var(--superficie); color: var(--ink); border: 1px solid var(--linha-2); border-radius: var(--raio); cursor: pointer; }
  .filtros button:hover { border-color: var(--tinta); }
  .filtros button[aria-pressed='true'] { background: var(--tinta); color: #fff; border-color: var(--tinta); }
  .fs14 { font-size: 14px; }
  .grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(520px, 100%), 1fr)); gap: 32px 24px; }
  .grade :global(.card[hidden]) { display: none; }
  .vazio { padding: 48px 0; font-size: 18px; }
</style>
