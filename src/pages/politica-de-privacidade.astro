---
import Base from '../layouts/Base.astro';
---
<Base titulo="Política de privacidade">
  <section class="wrap sec texto">
    <p class="rotulo">Institucional</p>
    <h1>Política de privacidade</h1>
    <p><span class="pend">[TEXTO DA POLÍTICA DE PRIVACIDADE PENDENTE: a Terrari deve fornecer o texto revisado pelo jurídico, incluindo controlador dos dados, finalidade do formulário de interesse, base legal (LGPD), prazo de retenção, compartilhamento com corretores/CRM e canal do encarregado.]</span></p>
  </section>
</Base>
<style>
  .texto { max-width: 820px; display: flex; flex-direction: column; gap: 24px; font-size: 18px; line-height: 1.7; }
  h1 { font-size: 48px; line-height: 1.08; }
</style>
