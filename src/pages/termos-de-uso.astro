---
import Base from '../layouts/Base.astro';
---
<Base titulo="Termos de uso">
  <section class="wrap sec texto">
    <p class="rotulo">Institucional</p>
    <h1>Termos de uso</h1>
    <p><span class="pend">[TEXTO DOS TERMOS DE USO PENDENTE: a Terrari deve fornecer o texto revisado pelo jurídico.]</span></p>
  </section>
</Base>
<style>
  .texto { max-width: 820px; display: flex; flex-direction: column; gap: 24px; font-size: 18px; line-height: 1.7; }
  h1 { font-size: 48px; line-height: 1.08; }
</style>
