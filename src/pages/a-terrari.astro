---
import Base from '../layouts/Base.astro';
import { TABELA_PRO_URL, u } from '../config';
import { listarEmpreendimentos, faseLabel, urlEmp } from '../lib/empreendimentos';

const MESES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
const ordemData = (t: string | null) => {
  if (!t) return Infinity;
  const [m, a] = t.toLowerCase().split('/');
  return Number(a) * 12 + MESES.indexOf(m.slice(0, 3));
};
const trajetoria = (await listarEmpreendimentos()).sort(
  (a, b) => ordemData(a.data.ficha.entrega) - ordemData(b.data.ficha.entrega),
);

const valores = [
  ['Qualidade', 'Compromisso com a excelência em todas as etapas dos empreendimentos.'],
  ['Transparência', 'Relações éticas, claras e confiáveis com clientes, parceiros e colaboradores.'],
  ['Inovação', 'Busca constante por soluções modernas, funcionais e eficientes.'],
  ['Comprometimento', 'Responsabilidade com cada projeto, prazo e compromisso assumido.'],
  ['Valorização', 'Desenvolvimento de imóveis que proporcionem qualidade de vida e potencial de valorização patrimonial.'],
  ['Respeito', 'Valorização das pessoas e construção de relacionamentos duradouros.'],
];
---
<Base titulo="A Terrari" descricao="Missão, visão e valores da Terrari Empreendimentos: qualidade, transparência, inovação, comprometimento, valorização e respeito.">
  <section class="bg-tinta">
    <div class="wrap topo">
      <p class="rotulo">A Terrari</p>
      <h1>Construindo o futuro com inteligência e qualidade.</h1>
      <p class="sub">Empreendimentos modernos, espaços bem planejados e oportunidades para viver e investir.</p>
    </div>
  </section>

  <section class="wrap sec mv">
    <div class="ph foto">[FOTO INSTITUCIONAL: equipe, sede ou obra]</div>
    <div class="mv-txt">
      <div class="bloco">
        <h2 class="mini">Nossa missão</h2>
        <p class="missao">Desenvolver empreendimentos imobiliários modernos, funcionais e de qualidade, oferecendo soluções inteligentes para morar e investir, com compromisso, transparência e valorização do patrimônio de nossos clientes.</p>
      </div>
      <div class="bloco linha">
        <h2 class="mini">Nossa visão</h2>
        <p class="visao">Ser reconhecida como uma incorporadora de referência em qualidade, credibilidade e inovação, ampliando nossa presença no mercado imobiliário por meio de empreendimentos que atendam às necessidades das pessoas e contribuam para o desenvolvimento das cidades.</p>
      </div>
    </div>
  </section>

  <section class="bg-branco">
    <div class="wrap sec col gap48">
      <div class="col gap12">
        <p class="rotulo">Nossos valores</p>
        <h2 class="h-sec">O que guia cada projeto</h2>
      </div>
      <div class="valores">
        {valores.map(([t, d], i) => (
          <div class="valor">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap sec col gap48">
    <div class="col gap12">
      <p class="rotulo">Nossa trajetória</p>
      <h2 class="h-sec">Entregas e próximos passos</h2>
    </div>
    <ol class="linha-tempo" style={`--n: ${trajetoria.length}`}>
      {trajetoria.map((e) => (
        <li class:list={['marco', e.data.fase]}>
          <span class="marco-data">{e.data.ficha.entrega ?? 'A definir'}</span>
          <span class="marco-ponto" aria-hidden="true"></span>
          <a href={urlEmp(e)} class="marco-nome">{e.data.nome}</a>
          <span class="marco-fase">
            {e.data.fase === 'entregue' ? 'Entregue' : e.data.fase === 'em-obras' ? `Em obras · ${e.data.obra ?? 0}%` : faseLabel(e)}
          </span>
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-branco">
  <div class="wrap sec cta">
    <h2 class="h-sec">Conheça os empreendimentos que carregam esses valores.</h2>
    <div class="btns">
      <a href={u('/empreendimentos')} class="btn btn-tinta btn-lg">Ver empreendimentos</a>
      <a href={TABELA_PRO_URL ?? u('/#corretores')} target={TABELA_PRO_URL ? '_blank' : undefined} rel="noopener" class="btn btn-ghost-escuro btn-lg">Área do corretor ↗</a>
    </div>
  </div>
  </section>
</Base>

<style>
  .topo { padding-top: 80px; padding-bottom: 88px; display: flex; flex-direction: column; gap: 24px; }
  .topo h1 { font-size: clamp(40px, 5.4vw, 72px); line-height: 1.03; max-width: 980px; }
  .sub { font-size: 20px; line-height: 1.55; color: var(--texto-claro); max-width: 640px; }
  .mv { display: flex; flex-wrap: wrap; gap: 56px; align-items: stretch; }
  .foto { flex: 1 1 460px; min-height: 460px; }
  .mv-txt { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 48px; justify-content: center; }
  .bloco { display: flex; flex-direction: column; gap: 16px; }
  .bloco.linha { border-top: 1px solid var(--linha-2); padding-top: 40px; }
  .mini { font-family: var(--corpo); font-size: 15px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--verde); }
  .missao { font-family: var(--titulo); font-size: 28px; line-height: 1.3; font-weight: 500; letter-spacing: -0.01em; }
  .visao { font-size: 18px; line-height: 1.65; color: var(--texto); }
  .gap48 { gap: 48px; }
  .gap12 { gap: 12px; }
  .valores { display: flex; flex-wrap: wrap; gap: 0 48px; }
  .valor { flex: 1 1 340px; min-width: 0; border-top: 1px solid var(--linha-2); padding: 28px 0 36px; display: flex; flex-direction: column; gap: 10px; }
  .n { font-family: var(--titulo); font-size: 15px; font-weight: 600; color: var(--verde); }
  .valor h3 { font-size: 24px; }
  .valor p { font-size: 16px; line-height: 1.6; color: var(--texto-2); }
  .linha-tempo { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); }
  .marco { position: relative; display: flex; flex-direction: column; gap: 10px; padding: 0 16px 0 0; }
  .marco::before { content: ''; position: absolute; left: 0; right: 0; top: 45px; height: 2px; background: var(--linha-2); }
  .marco-data { font-family: var(--titulo); font-size: 22px; font-weight: 600; }
  .marco-ponto { position: relative; width: 16px; height: 16px; border-radius: 50%; background: var(--fundo); border: 2px solid var(--verde); margin: 0 0 6px; }
  .entregue .marco-ponto { background: var(--verde); }
  .em-obras .marco-ponto { background: linear-gradient(90deg, var(--verde) 50%, var(--fundo) 50%); }
  .marco-nome { font-family: var(--titulo); font-size: 20px; font-weight: 600; color: var(--ink); text-decoration: none; }
  .marco-nome:hover { text-decoration: underline; }
  .marco-fase { font-size: 14px; color: var(--texto-2); }
  @media (max-width: 900px) {
    .linha-tempo { grid-template-columns: 1fr; gap: 24px; border-left: 2px solid var(--linha-2); padding-left: 20px; }
    .marco::before { display: none; }
    .marco-ponto { position: absolute; left: -29px; top: 6px; }
  }
  .cta { display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; }
  .cta h2 { flex: 1 1 480px; min-width: 0; }
  .btns { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 640px) {
    .foto { min-height: 280px; }
    .missao { font-size: 22px; }
    .topo { padding-top: 56px; padding-bottom: 64px; }
  }
</style>
